<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fitsSystemWindows="false" />

    <View
        android:id="@+id/touch"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand_orange"
        android:visibility="gone" />

    <!-- volume / brightness / zoom OSD -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd"
        android:gravity="center_horizontal"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="14dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/osdIcon"
            android:layout_width="32dp" android:layout_height="32dp" />
        <TextView
            android:id="@+id/osdText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="2" android:gravity="center" />
        <ProgressBar
            android:id="@+id/osdBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp" android:layout_height="4dp"
            android:layout_marginTop="8dp" android:max="100"
            android:progressDrawable="@drawable/progress_resume" />
    </LinearLayout>

    <!-- double-tap seek feedback -->
    <TextView
        android:id="@+id/tapLeft"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="48dp"
        android:background="@drawable/bg_osd" android:paddingHorizontal="16dp" android:paddingVertical="10dp"
        android:drawableTop="@drawable/ic_rewind" android:drawablePadding="4dp" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tapRight"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="48dp"
        android:background="@drawable/bg_osd" android:paddingHorizontal="16dp" android:paddingVertical="10dp"
        android:drawableTop="@drawable/ic_forward" android:drawablePadding="4dp" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:visibility="gone" />

    <!-- ===================== controls ===================== -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="6dp" android:paddingBottom="22dp">
            <ImageButton android:id="@+id/btnBack" style="@style/PlayerIcon"
                android:src="@drawable/ic_back_w" android:contentDescription="Back" />
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_marginEnd="6dp"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="16sp" app:autoSizeStepGranularity="1sp"
                android:shadowColor="#000000" android:shadowRadius="3" />
            <TextView
                android:id="@+id/btnDecoder"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp"
                android:minWidth="40dp" android:gravity="center"
                android:text="HW" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
                android:maxLines="1" />
            <ImageButton android:id="@+id/btnAudio" style="@style/PlayerIcon"
                android:src="@drawable/ic_audiotrack" android:contentDescription="Audio track" />
            <ImageButton android:id="@+id/btnSubs" style="@style/PlayerIcon"
                android:src="@drawable/ic_subtitles" android:contentDescription="Subtitles" />
            <ImageButton android:id="@+id/btnMore" style="@style/PlayerIcon"
                android:src="@drawable/ic_more_w" android:contentDescription="More" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/centerBar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/btnPrev"
                android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_circle_dark" android:padding="14dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/btnPlay"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_marginHorizontal="36dp"
                android:background="@drawable/bg_play_big" android:padding="18dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_pause_w" android:contentDescription="Play or pause" />
            <ImageButton android:id="@+id/btnNext"
                android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_circle_dark" android:padding="14dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" android:contentDescription="Next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="28dp" android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView
                    android:id="@+id/posText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="44dp" android:gravity="center"
                    android:text="00:00" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:fontFeatureSettings="tnum" android:maxLines="1" />
                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:progressTint="@color/brand_orange" android:thumbTint="@color/brand_orange"
                    android:progressBackgroundTint="#80FFFFFF" android:secondaryProgressTint="#B3FFFFFF"
                    android:paddingStart="12dp" android:paddingEnd="12dp" />
                <TextView
                    android:id="@+id/durText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="44dp" android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="00:00" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnLock" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_lock_open" android:contentDescription="Lock screen" />
                <ImageButton android:id="@+id/btnRotate" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_rotate" android:contentDescription="Rotate" />
                <ImageButton android:id="@+id/btnAspect" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_aspect" android:contentDescription="Aspect ratio" />
                <ImageButton android:id="@+id/btnSpeed" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_speed" android:contentDescription="Playback speed" />
                <ImageButton android:id="@+id/btnRepeat" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_repeat" android:alpha="0.5" android:contentDescription="Repeat" />
                <ImageButton android:id="@+id/btnPip" style="@style/PlayerIcon"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:src="@drawable/ic_pip" android:contentDescription="Picture in picture" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- shown only while locked -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="52dp" android:layout_height="52dp"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="24dp"
        android:background="@drawable/bg_circle_dark" android:padding="13dp" android:scaleType="fitCenter"
        android:src="@drawable/ic_lock" android:contentDescription="Unlock"
        android:visibility="gone" />

    <!-- "Resumed from" bar -->
    <LinearLayout
        android:id="@+id/resumeBar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp" android:layout_marginBottom="120dp" android:layout_marginEnd="16dp"
        android:background="@drawable/bg_osd"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/resumeText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView
            android:id="@+id/resumeStartOver"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="10dp" android:paddingVertical="10dp"
            android:text="START OVER" android:textColor="@color/brand_orange" android:textSize="13sp" android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
