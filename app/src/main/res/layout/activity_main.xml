<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bar"
        app:liftOnScroll="false"
        app:liftOnScrollColor="@color/bar"
        android:stateListAnimator="@null">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/bar"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.Material3.Dark"
            app:titleTextColor="#FFFFFF"
            app:contentInsetStart="12dp"
            app:contentInsetStartWithNavigation="0dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/logo_mrm" android:contentDescription="MRM Zone logo" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:layout_marginEnd="4dp" android:orientation="vertical">
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="MRM Zone Player" android:textColor="#FFFFFF"
                        android:textSize="19sp" android:textStyle="bold"
                        android:maxLines="1" android:ellipsize="end"
                        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="14sp"
                        app:autoSizeMaxTextSize="19sp" app:autoSizeStepGranularity="1sp" />
                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="HD Video Player • All Formats" android:textColor="@color/bar_text_dim"
                        android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp" app:autoSizeStepGranularity="0.5sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/bar"
            app:tabMode="fixed" app:tabGravity="fill"
            app:tabTextColor="@color/bar_text_dim" app:tabSelectedTextColor="#FFFFFF"
            app:tabIndicatorColor="@color/brand_orange" app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="3dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- IDM style command toolbar -->
        <HorizontalScrollView
            android:id="@+id/commandScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/surface" android:scrollbars="none" android:elevation="2dp">
            <LinearLayout
                android:id="@+id/commandBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingVertical="4dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clipToPadding="false" android:paddingBottom="88dp"
                    android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center_horizontal"
                android:paddingHorizontal="32dp"
                android:orientation="vertical" android:visibility="gone">
                <ImageView
                    android:id="@+id/emptyIcon"
                    android:layout_width="72dp" android:layout_height="72dp"
                    android:src="@drawable/ic_video_library" app:tint="@color/text_secondary" android:alpha="0.6" />
                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="No videos"
                    android:textColor="@color/text_primary" android:gravity="center"
                    android:textSize="18sp" android:textStyle="bold" android:alpha="0.8" />
                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="center"
                    android:text="Videos on your phone will show up here"
                    android:textSize="13sp" android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Allow access"
                    android:visibility="gone" app:backgroundTint="@color/brand_blue" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/bar" android:paddingHorizontal="14dp" android:paddingVertical="6dp"
            android:textColor="#D7DEE8" android:textSize="12sp" android:text="Ready"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp" android:layout_marginBottom="44dp"
        android:text="Resume" android:textColor="#FFFFFF"
        app:icon="@drawable/ic_play_w" app:iconTint="#FFFFFF"
        app:backgroundTint="@color/brand_orange" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
